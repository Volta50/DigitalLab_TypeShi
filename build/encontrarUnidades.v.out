#! /usr/bin/vvp
:ivl_version "12.0 (stable)" "(v12_0-dirty)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/ivl/system.vpi";
:vpi_module "/usr/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/ivl/va_math.vpi";
:vpi_module "/usr/lib/ivl/v2009.vpi";
S_0x55ec000558b0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55ec0002f4c0 .scope module, "bit_to_int_explicit_cast" "bit_to_int_explicit_cast" 3 1;
 .timescale 0 0;
v0x55ec0002f650_0 .var/2s "centenas", 31 0;
v0x55ec0007a280_0 .var/2s "decenas", 31 0;
v0x55ec0007a360_0 .var/2u "four_bit_unsigned", 7 0;
v0x55ec0007a420_0 .var/2s "signed_int", 31 0;
v0x55ec0007a500_0 .var/2s "unidades", 31 0;
    .scope S_0x55ec0002f4c0;
T_0 ;
    %pushi/vec4 255, 0, 8;
    %store/vec4 v0x55ec0007a360_0, 0, 8;
    %end;
    .thread T_0, $init;
    .scope S_0x55ec0002f4c0;
T_1 ;
    %load/vec4 v0x55ec0007a360_0;
    %pad/u 32;
    %store/vec4 v0x55ec0007a420_0, 0, 32;
    %vpi_call/w 3 11 "$display", "Unsigned 4-bit: %b", v0x55ec0007a360_0 {0 0 0};
    %vpi_call/w 3 12 "$display", "Signed int from unsigned 4-bit: %d", v0x55ec0007a420_0 {0 0 0};
    %load/vec4 v0x55ec0007a420_0;
    %pushi/vec4 10, 0, 32;
    %mod/s;
    %cast2;
    %store/vec4 v0x55ec0007a500_0, 0, 32;
    %vpi_call/w 3 15 "$display", "Unidades 4-bit: %d", v0x55ec0007a500_0 {0 0 0};
    %load/vec4 v0x55ec0007a420_0;
    %pushi/vec4 100, 0, 32;
    %mod/s;
    %pushi/vec4 10, 0, 32;
    %div/s;
    %cast2;
    %store/vec4 v0x55ec0007a280_0, 0, 32;
    %vpi_call/w 3 18 "$display", "Decenas 4-bit: %d", v0x55ec0007a280_0 {0 0 0};
    %load/vec4 v0x55ec0007a420_0;
    %pushi/vec4 100, 0, 32;
    %div/s;
    %cast2;
    %store/vec4 v0x55ec0002f650_0, 0, 32;
    %vpi_call/w 3 21 "$display", "Centenas 4-bit: %d", v0x55ec0002f650_0 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "-";
    "lab-03/encontrarUnidades.v";
