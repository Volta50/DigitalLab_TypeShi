#! /usr/bin/vvp
:ivl_version "12.0 (stable)" "(v12_0-dirty)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/ivl/system.vpi";
:vpi_module "/usr/lib/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/ivl/va_math.vpi";
:vpi_module "/usr/lib/ivl/v2009.vpi";
S_0x5615e67b08a0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x5615e678a4c0 .scope module, "bit_to_int_explicit_cast" "bit_to_int_explicit_cast" 3 1;
 .timescale 0 0;
v0x5615e678a650_0 .var/2s "centenas", 31 0;
v0x5615e67d5200_0 .var/2s "decenas", 31 0;
v0x5615e67d52e0_0 .var/2u "eight_bit_unsigned", 5 0;
v0x5615e67d53a0_0 .var/2s "signed_int", 31 0;
v0x5615e67d5480_0 .var/2s "unidades", 31 0;
    .scope S_0x5615e678a4c0;
T_0 ;
    %pushi/vec4 63, 0, 6;
    %store/vec4 v0x5615e67d52e0_0, 0, 6;
    %end;
    .thread T_0, $init;
    .scope S_0x5615e678a4c0;
T_1 ;
    %load/vec4 v0x5615e67d52e0_0;
    %pad/u 32;
    %store/vec4 v0x5615e67d53a0_0, 0, 32;
    %vpi_call/w 3 11 "$display", "Unsigned 4-bit: %b", v0x5615e67d52e0_0 {0 0 0};
    %vpi_call/w 3 12 "$display", "Signed int from unsigned 4-bit: %d", v0x5615e67d53a0_0 {0 0 0};
    %load/vec4 v0x5615e67d53a0_0;
    %pushi/vec4 10, 0, 32;
    %mod/s;
    %cast2;
    %store/vec4 v0x5615e67d5480_0, 0, 32;
    %vpi_call/w 3 15 "$display", "Unidades 4-bit: %d", v0x5615e67d5480_0 {0 0 0};
    %load/vec4 v0x5615e67d53a0_0;
    %pushi/vec4 100, 0, 32;
    %mod/s;
    %pushi/vec4 10, 0, 32;
    %div/s;
    %cast2;
    %store/vec4 v0x5615e67d5200_0, 0, 32;
    %vpi_call/w 3 18 "$display", "Decenas 4-bit: %d", v0x5615e67d5200_0 {0 0 0};
    %load/vec4 v0x5615e67d53a0_0;
    %pushi/vec4 100, 0, 32;
    %div/s;
    %cast2;
    %store/vec4 v0x5615e678a650_0, 0, 32;
    %vpi_call/w 3 21 "$display", "Centenas 4-bit: %d", v0x5615e678a650_0 {0 0 0};
    %end;
    .thread T_1;
